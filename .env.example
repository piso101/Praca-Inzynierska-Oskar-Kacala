# Copy this file to .env and replace every placeholder with unique local values.
# Never use these values on a public or production deployment.
POSTGRES_USER=survey_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=survey_dev

JWT_KEY=REPLACE_WITH_RANDOM_VALUE_AT_LEAST_32_BYTES
SURVEY_HASH_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_VALUE_AT_LEAST_32_BYTES
OWNER_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

MINIO_ROOT_USER=survey_dev_minio
MINIO_ROOT_PASSWORD=REPLACE_WITH_LOCAL_MINIO_PASSWORD
VITE_S3_ENDPOINT=http://localhost:9000

# Optional external integrations. Leave empty when not using them.
GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_FROM_EMAIL=
GMAIL_APP_PASSWORD=
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
